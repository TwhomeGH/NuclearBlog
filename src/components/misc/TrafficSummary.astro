---
import { umamiConfig } from "../../analytics.config.mjs";
interface Props { scope?: "site" | "article" }
const { scope = "site" } = Astro.props;
const shareUrl = umamiConfig.shareUrl?.trim();
---
{umamiConfig.showStats && shareUrl && <div class="traffic-summary" data-traffic-scope={scope}>
  <a href={shareUrl} target="_blank" rel="noopener noreferrer" aria-label="查看公開流量統計（Umami，另開分頁）">
    查看公開流量統計 <span aria-hidden="true">↗</span>
  </a>
  <small>Umami · 全站公開數據</small>
</div>}
<style>
.traffic-summary { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; padding: 6px 8px; font-size: 13px; line-height: 1.6; color: var(--content-meta); }
a { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; color: var(--primary); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
a:focus-visible { outline: 2px solid var(--primary); outline-offset: 4px; border-radius: 4px; }
small { font-size: 12px; }
</style>
