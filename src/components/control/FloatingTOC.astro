---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../../config";
---

<floating-toc hidden data-depth={siteConfig.toc.depth} data-japanese-badge={siteConfig.toc.useJapaneseBadge}>
	<div class="toc-toolbar">
		<button type="button" class="toc-toggle" aria-label="開啟文章目錄" aria-expanded="false" aria-controls="reading-toc-panel">
			<Icon name="material-symbols:format-list-bulleted-rounded" />
			<span class="toc-label"><span>目錄</span><small data-progress title="閱讀進度">0%</small></span>
		</button>
		<button type="button" class="toc-move" data-floating-drag aria-label="移動目錄；方向鍵移動，Home 重設" title="拖曳移動；方向鍵移動，Home 重設">
			<Icon name="material-symbols:drag-indicator" />
		</button>
	</div>
	<section id="reading-toc-panel" hidden aria-label="文章目錄">
		<div class="toc-panel-header"><span>跳到章節</span><button type="button" data-floating-reset>重設位置</button></div>
		<nav aria-label="文章章節" class="toc-links"></nav>
	</section>
</floating-toc>

<style>
	floating-toc { position: fixed; right: 16px; bottom: 16px; z-index: 70; display: block; width: 176px; max-width: calc(100vw - 32px); background: var(--card-bg); color: var(--primary); border: 1px solid var(--line-divider); border-radius: 16px; box-shadow: 0 6px 24px #0002; }
	floating-toc[hidden], [hidden] { display: none !important; }
	floating-toc[data-open="true"] { width: 320px; }
	.toc-toolbar { display: flex; justify-content: space-between; padding: 4px; }
	button { min-height: 44px; border-radius: 10px; }
	button:hover { background: var(--btn-regular-bg); }
	button:focus-visible, :global(.toc-link:focus-visible) { outline: 2px solid var(--primary); outline-offset: -2px; }
	.toc-toggle { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0; padding: 0 8px; text-align: left; font-size: 14px; line-height: 1.2; }
	.toc-toggle svg { width: 22px; height: 22px; }
	.toc-label { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
	small { display: inline-flex; align-items: center; justify-content: center; min-width: 4ch; padding: 4px 5px; border-radius: 999px; background: var(--btn-regular-bg); font-size: 11px; line-height: 1; font-variant-numeric: tabular-nums; }
	.toc-move { width: 44px; flex-shrink: 0; display: grid; place-items: center; cursor: grab; touch-action: none; user-select: none; }
	.toc-move svg { width: 22px; height: 22px; }
	floating-toc[data-dragging="true"] .toc-move { cursor: grabbing; }
	.toc-panel-header { display: flex; align-items: center; justify-content: space-between; padding: 0 12px; border-top: 1px solid var(--line-divider); font-size: 13px; }
	.toc-panel-header button { padding: 0 8px; }
	.toc-links { max-height: min(55dvh, calc(100dvh - 150px)); overflow-y: auto; overscroll-behavior: contain; padding: 4px 8px 12px; }
	:global(.toc-link) { display: block; padding: 10px 8px; padding-left: calc(8px + var(--toc-level) * 12px); min-height: 44px; border-radius: 8px; color: var(--content-meta); font-size: 14px; line-height: 1.5; overflow-wrap: anywhere; }
	:global(.toc-link:hover), :global(.toc-link[aria-current="location"]) { background: var(--btn-regular-bg); color: var(--primary); }
	:global(.toc-link[aria-current="location"]) { font-weight: 700; box-shadow: inset 3px 0 var(--primary); }
</style>

<script>
	import { floatingPanel } from "../../utils/floating-panel";

	class ReadingTOC extends HTMLElement {
		private events?: AbortController;
		private observer?: MutationObserver;
		private dock?: ReturnType<typeof floatingPanel>;
		private frame = 0;
		private refreshFrame = 0;
		private headings: HTMLElement[] = [];
		private links: HTMLAnchorElement[] = [];
		private signature = "";
		private article: HTMLElement | null = null;
		private open = false;
		private toggle!: HTMLButtonElement;
		private panel!: HTMLElement;
		private nav!: HTMLElement;

		connectedCallback() {
			this.events = new AbortController();
			const options = { signal: this.events.signal };
			this.toggle = this.querySelector(".toc-toggle")!;
			this.panel = this.querySelector("section")!;
			this.nav = this.querySelector("nav")!;
			this.dock = floatingPanel(this, { key: "reading-toc-position-v1", side: "right" });
			this.toggle.addEventListener("click", () => this.setOpen(!this.open), options);
			this.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && this.open) { this.setOpen(false); this.toggle.focus(); }
			}, options);
			document.addEventListener("pointerdown", (event) => {
				if (this.open && !this.contains(event.target as Node)) this.setOpen(false);
			}, options);
			this.nav.addEventListener("click", (event) => {
				const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-index]");
				if (!link) return;
				const heading = this.headings[Number(link.dataset.index)];
				if (!heading) return;
				event.preventDefault();
				this.setOpen(false);
				const top = Math.max(0, heading.getBoundingClientRect().top + window.scrollY - 96);
				window.scrollTo({ top, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth" });
				history.replaceState(history.state, "", "#" + encodeURIComponent(heading.id));
				this.toggle.focus({ preventScroll: true });
			}, options);
			window.addEventListener("scroll", this.queueUpdate, { ...options, passive: true });
			window.addEventListener("resize", this.queueUpdate, options);
			document.addEventListener("reading-tool:open", (event) => {
				if ((event as CustomEvent).detail !== "toc") this.setOpen(false);
			}, options);
			document.addEventListener("DOMContentLoaded", this.refresh, options);
			document.addEventListener("swup:page:view", this.refresh, options);
			// 監看 main 的替換與解密內容；不監看目錄自身，避免更新迴圈。
			this.observer = new MutationObserver((records) => {
				if (!records.some(r => (r.target instanceof Element && r.target.closest("main")) || [...r.addedNodes, ...r.removedNodes].some(n => n instanceof Element && (n.matches("main") || n.querySelector("main"))))) return;
				cancelAnimationFrame(this.refreshFrame);
				this.refreshFrame = requestAnimationFrame(this.refresh);
			});
			this.observer.observe(document.body, { childList: true, subtree: true, characterData: true });
			this.refresh();
		}
		disconnectedCallback() {
			this.events?.abort(); this.observer?.disconnect(); this.dock?.destroy();
			cancelAnimationFrame(this.frame); cancelAnimationFrame(this.refreshFrame);
		}
		private setOpen(open: boolean) {
			if (open) document.dispatchEvent(new CustomEvent("reading-tool:open", { detail: "toc" }));
			this.open = open;
			this.dataset.open = String(open);
			this.panel.hidden = !open;
			this.toggle.setAttribute("aria-expanded", String(open));
			this.toggle.setAttribute("aria-label", open ? "收合文章目錄" : "開啟文章目錄");
		}
		private refresh = () => {
			const article = document.getElementById("post-container");
			const all = Array.from(article?.querySelectorAll<HTMLElement>("h1[id],h2[id],h3[id],h4[id],h5[id],h6[id]") || []);
			const signature = JSON.stringify(all.map(h => [h.id, h.textContent]));
			if (article === this.article && signature === this.signature) return;
			this.article = article; this.signature = signature;
			this.setOpen(false);
			const min = Math.min(...all.map(h => Number(h.tagName[1])));
			const depth = Math.max(1, Number(this.dataset.depth) || 3);
			this.headings = all.filter(h => Number(h.tagName[1]) < min + depth);
			this.hidden = this.headings.length === 0;
			this.links = [];
			const fragment = document.createDocumentFragment();
			let number = 0;
			const kana = [..."アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホ"];
			this.headings.forEach((heading, index) => {
				const level = Number(heading.tagName[1]) - min;
				const link = document.createElement("a");
				link.className = "toc-link";
				link.href = "#" + encodeURIComponent(heading.id);
				link.dataset.index = String(index);
				link.style.setProperty("--toc-level", String(level));
				const text = heading.cloneNode(true) as HTMLElement;
				text.querySelectorAll(".anchor").forEach(anchor => anchor.remove());
				const badge = level === 0 ? (this.dataset.japaneseBadge === "true" ? kana[number++] || String(number) : String(++number)) + ". " : "";
				link.textContent = badge + (text.textContent || "").trim();
				fragment.append(link); this.links.push(link);
			});
			this.nav.replaceChildren(fragment);
			this.update();
		};
		private queueUpdate = () => { cancelAnimationFrame(this.frame); this.frame = requestAnimationFrame(() => this.update()); };
		private update() {
			if (!this.article || !this.headings.length) return;
			let current = 0;
			this.headings.forEach((heading, i) => { if (heading.getBoundingClientRect().top <= 120) current = i; });
			this.links.forEach((link, i) => { if (i === current) link.setAttribute("aria-current", "location"); else link.removeAttribute("aria-current"); });
			const rect = this.article.getBoundingClientRect();
			const total = Math.max(1, rect.height - window.innerHeight);
			const progress = Math.round(Math.max(0, Math.min(1, -rect.top / total)) * 100);
			this.querySelector("[data-progress]")!.textContent = progress + "%";
		}
	}
	if (!customElements.get("floating-toc")) customElements.define("floating-toc", ReadingTOC);
</script>